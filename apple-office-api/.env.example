DATABASE_URL="mysql://root:PASSWORD@localhost:3306/apple_office"

# Clave con la que se firman las sesiones del panel de administración.
# En PRODUCCIÓN tiene que ser un valor largo, secreto y propio (ej: `openssl rand -hex 48`).
# Si falta, el servidor arranca igual pero usa una clave por defecto que está en el repo (pública)
# y muestra una advertencia en el log. Cambiarla cierra todas las sesiones abiertas.
JWT_SECRET=
